# Telegram bot token from @BotFather (needed from Day 3 onward)
TELEGRAM_BOT_TOKEN=
# Optional: override the default public RPCs
MATSNET_RPC_URL=https://rpc.test.mezo.org

# Where the bot stores tracked addresses (local dev)
STORE_PATH=data/store.json

# How often to check tracked troves, in seconds (minimum 15)
POLL_SECONDS=60
# DEMO ONLY: leave blank normally. Setting e.g. 40 makes alerts simulate a 40% BTC price
# drop (clearly labelled) so you can see them fire on a healthy position.
DEMO_PRICE_DROP_PCT=

# Needed only for the hosted (Cloudflare) version. 16+ letters/digits, made up by you.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=

# Only for the local bot: your public https address, so replies get an "Open dashboard" button. Leave blank locally.
SITE_URL=
